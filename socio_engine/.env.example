# Socio-Engine API 密钥配置文件示例
# 复制本文件为 .env 并在下方填入真实 API Key 即可生效：
# cp .env.example .env

# DeepSeek 官方 API 密钥 (https://platform.deepseek.com)
DEEPSEEK_API_KEY=sk-your-deepseek-api-key-here

# 可选：OpenAI API 密钥
OPENAI_API_KEY=sk-your-openai-api-key-here

# 可选：Anthropic API 密钥
ANTHROPIC_API_KEY=sk-ant-your-anthropic-key-here

